{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HomenSAI/Error-database/schema/error-code.schema.json",
  "title": "HomenS.AI error code file",
  "type": "object",
  "required": ["namespace", "module", "codes"],
  "additionalProperties": false,
  "properties": {
    "namespace": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$"},
    "module": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$"},
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "level", "title", "action", "since"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}-[A-Z0-9][A-Z0-9-]{1,60}$"},
          "level": {"enum": ["info", "warn", "error", "alarm"]},
          "title": {"$ref": "#/$defs/i18n"},
          "action": {"$ref": "#/$defs/i18n"},
          "help": {"type": "string"},
          "since": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "deprecated": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": ["ru", "uk", "en", "de"],
      "additionalProperties": false,
      "properties": {"ru": {"type": "string", "minLength": 1}, "uk": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}}
    }
  }
}
